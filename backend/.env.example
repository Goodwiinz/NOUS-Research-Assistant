# Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED IN PRODUCTION/STAGING (will fail to start without these)
# =============================================================================

# Application secret key - must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# JWT secret key for authentication - must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Neo4j database password
NEO4J_PASSWORD=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_rag

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Neo4j configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j


# DigitalOcean Knowledge Base (Public Preview).
# Set DO_KB_ENABLED=true to dual-write ingests; SHADOW_READ for parallel
DO_KB_ENABLED=false
DO_KB_PRIMARY_READ=false
DO_API_TOKEN=
DO_KB_REGION=tor1
DO_KB_PROJECT_ID=
DO_KB_EMBEDDING_MODEL_UUID=
# Defaults usually fine:
DO_KB_API_HOST=https://api.digitalocean.com
DO_KB_RETRIEVE_HOST=https://kbaas.do-ai.run
DO_KB_DEFAULT_TOP_K=8
DO_KB_RETRIEVE_ALPHA=0.5
DO_KB_REQUEST_TIMEOUT_SECONDS=30
DO_KB_INDEXING_TIMEOUT_SECONDS=120

# Project skills rollout. Keep every gate off outside the deliberately staged
# dev rollout. The catalog API/UI treats its disabled state as unavailable.
AGENT_TOOL_REGISTRY_ENFORCEMENT_ENABLED=false
PROJECT_SKILL_CATALOG_ENABLED=false
PROJECT_SKILL_RUNTIME_ENABLED=false
PROJECT_SKILL_SNAPSHOT_RETENTION_DAYS=30

# Supabase (local dev via supabase start)
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_URL="postgresql://postgres:postgres@localhost:54322/postgres"
SUPABASE_JWT_SECRET=""  # From: npx supabase status (JWT secret)

# =============================================================================
# AI/LLM API KEYS (Optional - for AI features)
# =============================================================================

# OpenAI API key
OPENAI_API_KEY=

# Anthropic API key
ANTHROPIC_API_KEY=

# Azure OpenAI configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=

# Chat completions: route through Azure model-router (auto-selects gpt-4o, gpt-5,
# o4-mini, etc. per query). The /openai/v1/ suffix uses the OpenAI-compatible
# client; see backend/src/core/openai_endpoint.py.
AZURE_OPENAI_CHAT_ENDPOINT=https://goodwiinzapix.cognitiveservices.azure.com/openai/v1/
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=model-router
# Lightweight deployment for classifier, compactor, reflection, planner, memory-store.
# Falls back to AZURE_OPENAI_CHAT_DEPLOYMENT_NAME when unset — leave it blank
# to run one deployment everywhere. It used to fall back to model-router,
# which put the router back inside the agent loop (trace 019e1da5, 30s cap).
#
# A smaller deployment here is a cost lever on the high-frequency
# classify/route path, but do NOT put one on a tool-calling turn: multi-step
# function calling is where small tiers collapse (dev A/B: gpt-5-nano at
# reasoning_effort=minimal called the ingest tool on 1 of 23 runs).
AZURE_OPENAI_LIGHTWEIGHT_DEPLOYMENT=gpt-5.6-luna

# Optional TypeSafe intent router. Azure remains the default and fallback.
AGENT_INTENT_PROVIDER=azure
# Supply TYPESAFE_API_KEY through your secret manager; never commit a real value.
# TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT_SECONDS=1.0
# Leave unset until calibrated on reviewed data (an empty value is not a float).
# TYPESAFE_MIN_CONFIDENCE=<calibrated value between 0 and 1>

# Optional separate deployment for post-tool prose synthesis (main llm_node
# lightweight branch + research/writing/data subgraph synthesis turns).
# Falls back to AZURE_OPENAI_LIGHTWEIGHT_DEPLOYMENT, then to
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME. Leave blank to run one deployment
# everywhere; set it only to make prose cheaper than tool decisions.
AZURE_OPENAI_SYNTHESIS_DEPLOYMENT=gpt-5.6-luna

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================

# Maximum concurrent processing jobs
MAX_CONCURRENT_JOBS=5

# Job retry configuration
JOB_RETRY_MAX=3
JOB_RETRY_DELAY=5

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================

# Default and maximum search result limits
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=50

# Embedding model (sentence_transformers, azure_openai, auto)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# FILE STORAGE
# =============================================================================

# Storage backend: "local", "s3", or "supabase"
STORAGE_BACKEND=local

# Upload directory (used for local backend)
UPLOAD_DIR=./uploads

# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Free tier storage limit in GB
FREE_TIER_STORAGE_GB=10

# S3-Compatible Object Storage (DigitalOcean Spaces)
# S3_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
# S3_ACCESS_KEY=your-spaces-access-key
# S3_SECRET_KEY=your-spaces-secret-key
# S3_BUCKET_NAME=rag-system-storage
# S3_REGION=nyc3
# S3_CDN_ENDPOINT=https://rag-system-storage.nyc3.cdn.digitaloceanspaces.com

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Enable metrics collection
ENABLE_METRICS=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# LANGSMITH TRACING (optional — enables smith.langchain.com traces for the agent)
# =============================================================================
# Without LANGSMITH_API_KEY set, configure_langsmith() is a no-op and no traces
# are sent. Accepts either LANGSMITH_* (preferred) or legacy LANGCHAIN_* names.
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=rag-agent
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# SENTRY (optional — error tracking + performance monitoring)
# =============================================================================
# Without SENTRY_DSN set, init_sentry() is a no-op. In production source it
# from the `app-secrets` k8s secret, never commit it.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project_id>
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# APP_VERSION=1.0.0
# Set to "true" to expose /api/v1/sentry-debug in production (off by default).
# SENTRY_DEBUG_ENABLED=false
# Optional paper-discovery credentials. OpenAlex keys are sent as bearer headers.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
