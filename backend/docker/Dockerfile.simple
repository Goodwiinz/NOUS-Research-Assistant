FROM python:3.15-slim

# Set environment variables for better pip performance
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# Install basic system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libmagic1 \
    libmagic-dev \
    file \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy requirements files first
COPY requirements.txt requirements.dev.txt ./

# Upgrade pip and keep setuptools on a pybtex-compatible version.
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<72"

# Install basic requirements that won't cause compilation issues
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir "setuptools<72" && \
    python -c "import pkg_resources"

# Install spaCy English model for entity extraction
RUN pip install --no-cache-dir https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.7.0/en_core_web_sm-3.7.0-py3-none-any.whl

# Copy application code
COPY . .

# Create uploads directory with proper permissions
RUN mkdir -p /app/uploads/documents \
    /app/uploads/images \
    /app/uploads/audio \
    /app/uploads/video \
    /app/uploads/temp \
    /app/uploads/processed \
    && chmod 755 /app/uploads

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app
USER app

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Run the application
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
