# syntax=docker/dockerfile:1
# Production-optimized Dockerfile for Multimodal RAG Backend
# Multi-stage build with security hardening and performance optimization
# Optimized for remote builds

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS base

# Install system dependencies with security updates
# Note: Using libgl1 instead of libgl1-mesa-glx for Debian Trixie compatibility
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    tesseract-ocr \
    tesseract-ocr-eng \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1 \
    libmagic1 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz-subset0 \
    fonts-dejavu-core \
    wget \
    procps \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_EXTRA_INDEX_URL="https://pypi.org/simple" \
    PATH="/app/.local/bin:$PATH"

# Create non-root user
RUN groupadd -g 1001 appuser && \
    useradd -u 1001 -g appuser -s /bin/bash -d /app appuser

# Set working directory
WORKDIR /app

# Stage 2: Build dependencies
FROM base AS dependencies

# When true, install CPU-only PyTorch (saves ~5GB, used in CI)
ARG TORCH_CPU_ONLY=false

# Copy requirements files
COPY backend/requirements.txt backend/requirements-minimal.txt ./

# Upgrade pip and install dependencies.  The CPU index is included in the
# same resolver transaction so a later dependency cannot replace the CPU
# wheel with a CUDA build.
RUN \
    pip install --upgrade pip wheel "setuptools<72" && \
    if [ "$TORCH_CPU_ONLY" = "true" ]; then \
        pip install --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.txt && \
        python -c 'import torch; assert torch.version.cuda is None, f"CPU build resolved CUDA torch: {torch.__version__} ({torch.version.cuda})"'; \
    else \
        pip install -r requirements.txt; \
    fi && \
    pip install "setuptools<72" && \
    python -c "import pkg_resources" && \
    python -c 'from weasyprint import HTML; pdf = HTML(string="<h1>PDF smoke</h1>").write_pdf(); assert pdf.startswith(b"%PDF-")'

# Stage 3: Build with minimal dependencies
FROM base AS production

ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA

# Copy Python dependencies
COPY --from=dependencies /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=dependencies /usr/local/bin /usr/local/bin

# Copy application code
COPY backend/ .
COPY backend/docker/start-production.sh /usr/local/bin/
RUN chmod 0755 /usr/local/bin/start-production.sh

# Download the model version compatible with the pinned spaCy release.  Do
# not let the model's installer re-resolve the already validated application
# requirements.
RUN pip install --no-cache-dir --no-deps \
    https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl && \
    pip check && \
    python -c 'import cv2, spacy, torch; from weasyprint import HTML; assert spacy.__version__ == "3.8.16", spacy.__version__; nlp = spacy.load("en_core_web_sm"); assert nlp.meta.get("version") == "3.8.0", nlp.meta.get("version"); pdf = HTML(string="<h1>PDF smoke</h1>").write_pdf(); assert pdf.startswith(b"%PDF-"), pdf[:8]; print("validated torch=%s cuda=%s spacy=%s model=%s opencv=%s pdf_bytes=%d" % (torch.__version__, torch.version.cuda, spacy.__version__, nlp.meta["version"], cv2.__version__, len(pdf)))'

# Create necessary directories
RUN mkdir -p uploads logs models && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Set environment variables for production
ENV GUNICORN_WORKERS=1 \
    GUNICORN_THREADS=2 \
    GUNICORN_TIMEOUT=300 \
    GUNICORN_MAX_REQUESTS=1000 \
    GUNICORN_MAX_REQUESTS_JITTER=100 \
    GUNICORN_GRACEFUL_TIMEOUT=30

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with validated, environment-configurable Gunicorn settings.
ENTRYPOINT ["start-production.sh"]
