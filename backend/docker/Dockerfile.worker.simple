FROM python:3.15-slim

# Set environment variables for better pip performance and Celery
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    C_FORCE_ROOT=1

# Set working directory
WORKDIR /app

# Install basic system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    libmagic1 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy development requirements first
COPY requirements.dev.txt .

# Upgrade pip and keep setuptools on a pybtex-compatible version.
RUN pip install --no-cache-dir --upgrade pip wheel "setuptools<72"

# Install basic requirements that won't cause compilation issues
RUN pip install --no-cache-dir -r requirements.dev.txt && \
    pip install --no-cache-dir "setuptools<72" && \
    python -c "import pkg_resources"

# Copy application code
COPY . .

# Create uploads directory with proper permissions
RUN mkdir -p /app/uploads/documents \
    /app/uploads/images \
    /app/uploads/audio \
    /app/uploads/video \
    /app/uploads/temp \
    /app/uploads/processed \
    && chmod 755 /app/uploads

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash app && \
    chown -R app:app /app
USER app

# Health check for worker
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD python -c "import redis; r=redis.Redis(host='redis', port=6379); r.ping()" || exit 1

# Run the Celery worker
CMD ["celery", "-A", "src.tasks.processing_tasks.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
