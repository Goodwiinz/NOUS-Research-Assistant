# syntax=docker/dockerfile:1
# Canonical production and CI image for the frontend. Build from repository root.

ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-alpine AS base

RUN apk add --no-cache libc6-compat && \
    corepack enable && \
    corepack prepare pnpm@10.18.2 --activate

WORKDIR /app

# The root lockfile is the sole dependency authority. Copy every workspace
# manifest before install so pnpm can construct deterministic workspace links.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json frontend/package.json
COPY packages/chat-runtime/package.json packages/chat-runtime/package.json
COPY tests/e2e/package.json tests/e2e/package.json

FROM base AS dependencies

RUN pnpm install --frozen-lockfile --filter multimodal-rag-frontend...

FROM dependencies AS builder

# NEXT_PUBLIC_* values are baked into client JavaScript by Next.js.
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WS_URL
ARG NEXT_PUBLIC_STATSIG_CLIENT_KEY
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_APP_ENV
ARG NEXT_PUBLIC_APP_URL
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ARG BACKEND_URL
ARG NEXT_PUBLIC_GIT_SHA
ARG NEXT_PUBLIC_AUTH_COOKIE_NAME

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL
ENV NEXT_PUBLIC_STATSIG_CLIENT_KEY=$NEXT_PUBLIC_STATSIG_CLIENT_KEY
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV SENTRY_ORG=$SENTRY_ORG
ENV SENTRY_PROJECT=$SENTRY_PROJECT
ENV BACKEND_URL=$BACKEND_URL
ENV NEXT_PUBLIC_GIT_SHA=$NEXT_PUBLIC_GIT_SHA
ENV NEXT_PUBLIC_AUTH_COOKIE_NAME=$NEXT_PUBLIC_AUTH_COOKIE_NAME
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY frontend/ frontend/
COPY packages/chat-runtime/ packages/chat-runtime/

# Keep public present even when the application has no checked-in public assets
# so the runner copy remains deterministic.
RUN --mount=type=secret,id=sentry_auth_token,env=SENTRY_AUTH_TOKEN \
    mkdir -p frontend/public && \
    if [ -z "$NEXT_PUBLIC_SUPABASE_URL" ] || [ -z "$NEXT_PUBLIC_SUPABASE_ANON_KEY" ]; then \
      echo "NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY must be set at build time." >&2; \
      exit 1; \
    fi && \
    pnpm --filter multimodal-rag-frontend build

FROM node:${NODE_VERSION}-alpine AS runner

RUN apk add --no-cache curl dumb-init && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

# outputFileTracingRoot is the repository root, so Next emits the server at
# .next/standalone/frontend/server.js and shared traced dependencies beside the
# frontend directory. Copy the entire standalone tree, then add static/public.
WORKDIR /app
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/frontend/.next/static ./frontend/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/frontend/public ./frontend/public

WORKDIR /app/frontend

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
