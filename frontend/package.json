  "scripts": {
    "dev": "infisical run --path=/frontend-build -- next dev",
    "dev:offline": "next dev",
    "build": "next build && node scripts/analyze-bundle.cjs",
    "build:cloud": "infisical run --path=/frontend-build -- next build && node scripts/analyze-bundle.cjs",
    "analyze:bundle": "node scripts/analyze-bundle.cjs",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutants": "node scripts/ci/run_chat_mutants.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test --grep=@smoke",
    "test:e2e:regression": "playwright test --grep=@regression",
    "test:e2e:accessibility": "playwright test --project=accessibility",
    "test:e2e:performance": "playwright test --project=performance",
    "test:e2e:visual": "playwright test --project=visual",
    "test:visual:responses": "playwright test --config=playwright.response-layout.config.ts",
    "test:visual:responses:update": "playwright test --config=playwright.response-layout.config.ts --update-snapshots",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test --project=iPhone --project=Android",
    "test:e2e:report": "playwright test --reporter=html",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:show-report": "playwright show-report",
    "test:e2e:show-trace": "playwright show-trace trace.zip",
    "lint": "eslint app src",
    "lint:fix": "eslint --fix app src",
    "lint:changed": "node ../scripts/ci/check_frontend_quality.mjs",
    "quality:exclusions": "python3 ../scripts/ci/check_tsconfig_exclusions.py",
    "format": "prettier --write src/**/*.{ts,tsx,css,md}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css,md}",
    "type-check": "tsc --noEmit",
    "validate": "pnpm lint && pnpm type-check && pnpm test",
    "generate:api-types": "openapi-typescript ../backend/openapi.json -o src/types/generated/api.d.ts",
    "check:api-types": "pnpm generate:api-types && git diff --exit-code -- ../backend/openapi.json src/types/generated/api.d.ts",
    "capture": "node scripts/capture.js",
    "cli": "tsx cli/index.ts"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  },
  "browserslist": {
    "production": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8000"
}
