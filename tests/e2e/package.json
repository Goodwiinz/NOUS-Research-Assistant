{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "End-to-end testing framework for Knowledge Graph Analytics Dashboard",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:visual": "playwright test --config=playwright-visual.config.ts",
    "test:e2e:accessibility": "playwright test --config=playwright-accessibility.config.ts",
    "test:e2e:mobile": "playwright test --config=playwright-mobile.config.ts",
    "test:e2e:performance": "playwright test --config=playwright-performance.config.ts",
    "test:e2e:ci": "playwright test --reporter=html,github --shard=${CI_SHARD_INDEX}/${CI_SHARD_TOTAL}",
    "test:e2e:setup": "node tests/setup/global-setup.js",
    "test:e2e:teardown": "node tests/setup/global-teardown.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.59.1",
    "axe-playwright": "^2.0.1",
    "chrome-remote-interface": "^0.34.0",
    "csvtojson": "^2.0.10",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "joi": "^18.1.2",
    "lighthouse": "^13.4.1",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "pa11y": "^10.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.47.2",
    "pngjs": "^7.0.0",
    "uuid": "^14.0.1"
  }
}
