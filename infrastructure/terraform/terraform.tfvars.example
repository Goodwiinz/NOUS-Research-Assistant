# Example Terraform Variables Configuration (lean dev sizing)
# Copy this file to terraform.tfvars and update with your values.
# NOTE: only variables declared in variables.tf may appear here.

# AWS Configuration
project_name = "nous"
environment = "development"
aws_region = "us-east-1"
owner_email = "devops@example.com" # fill before apply

# EKS Configuration
cluster_name = "nous-dev-cluster"
eks_cluster_version = "1.28"

# Network Configuration
vpc_cidr = "10.0.0.0/16"

# Node Group (single lean SPOT node group; second "spot" group in main.tf
# stays dormant at desired 0 with a NO_SCHEDULE taint)
min_nodes = 1
max_nodes = 3
desired_nodes = 1
node_instance_types = ["t3.large"]

# Database Configuration (RDS PostgreSQL)
db_instance_class = "db.t4g.small"
db_allocated_storage = 20
db_max_allocated_storage = 100
db_name = "multimodal_rag"
db_username = "raguser"

# Redis Configuration (ElastiCache, single node — failover disabled in main.tf)
redis_node_type = "cache.t4g.small"
redis_number_nodes = 1

# Terraform State (provision these before first apply)
terraform_state_bucket = "nous-tfstate-us-east-1"
terraform_lock_table = "nous-tfstate-lock"

# Monitoring and Alerting
enable_monitoring = true
log_retention_days = 30
enable_cross_region_backup = false # lean dev: skip DR bucket
enable_alerts = false
alert_email = "" # fill before apply if enable_alerts = true
slack_webhook_url = ""
