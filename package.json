{
  "name": "multimodal-rag-monorepo",
  "version": "1.0.0",
  "description": "Multimodal Enterprise RAG System - Monorepo Root",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "workspaces": [
    "frontend",
    "tests/e2e",
    "terminal",
    "packages/chat-runtime"
  ],
  "scripts": {
    "dev": "pnpm --filter multimodal-rag-frontend dev",
    "build": "pnpm --filter multimodal-rag-frontend build",
    "build:frontend": "pnpm --filter multimodal-rag-frontend build",
    "start": "pnpm --filter multimodal-rag-frontend start",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter ./tests/e2e test:e2e",
    "qa:nous": "node scripts/nous-qa.mjs",
    "validate": "pnpm --filter multimodal-rag-frontend validate",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules",
    "install:all": "pnpm install",
    "trigger:dev": "pnpm dlx trigger.dev@4.4.6 dev",
    "trigger:deploy": "pnpm dlx trigger.dev@4.4.6 deploy"
  },
  "dependencies": {
    "@trigger.dev/sdk": "4.4.6"
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/multimodal-rag-system"
  },
  "keywords": [
    "rag",
    "multimodal",
    "enterprise",
    "knowledge-graph",
    "nextjs"
  ],
  "author": "",
  "license": "MIT"
}
